{
  "datasets": [
    {
      "name": "champion_stats",
      "displayName": "Champion Statistics",
      "queryLines": [
        "SELECT\n",
        "    champion_id,\n",
        "    champion_name,\n",
        "    most_picked_lane,\n",
        "    ROUND(primary_lane_share * 100, 2) AS primary_lane_share,\n",
        "    global_games_played,\n",
        "    ROUND(global_pick_rate * 100, 2) AS global_pick_rate,\n",
        "    ROUND(global_win_rate * 100, 2) AS global_win_rate,\n",
        "    ROUND(global_ban_rate * 100, 2) AS global_ban_rate\n",
        "FROM league_records.gold.champion_overviews\n",
        ";"
      ],
      "catalog": "league_records",
      "schema": "gold"
    }
  ],
