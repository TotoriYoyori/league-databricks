   "source": [
    "USE CATALOG league_records;\n",
    "\n",
    "USE SCHEMA gold;\n",
    "\n",
    "SELECT \n",
    "    item_name,\n",
    "    player_purchase_rate, \n",
    "    win_rate,\n",
    "    top_item_1,\n",
    "    top_item_2,\n",
    "    top_item_3\n",
    "FROM item_recommendations\n",
    "WHERE champion_name = 'JHIN'\n",
    "    AND item_category = 'Legendary'\n",
    "ORDER BY player_purchase_rate DESC\n",
    ";"
   ]
  }
